# meeting-backend mail delivery configuration
#
# Copy this file to the deployment root, for example:
#   /data/07c2.com.cn/meeting/meeting-backend.env
# Then fill in the real values and keep that file outside the repository.

MEETING_MAILER_MODE=sendcloud_api
MEETING_SENDCLOUD_API_BASE_URL=https://api.sendcloud.net/apiv2
MEETING_SENDCLOUD_API_USER=replace_with_real_api_user
MEETING_SENDCLOUD_API_KEY=replace_with_real_api_key
MEETING_SENDCLOUD_FROM_ADDRESS=no-reply@mail.07c2.com.cn
MEETING_SENDCLOUD_FROM_NAME=meeting
MEETING_AUTH_CODE_SUBJECT_PREFIX=[meeting]

# Optional daily traffic statistics report.
# Leave MEETING_STATS_REPORT_TO empty or commented out to disable sending.
# MEETING_STATS_REPORT_SEND_AT_UTC uses HH:MM in UTC and defaults to 12:00 when omitted.
# MEETING_STATS_REPORT_TO=ops@example.com,admin@example.com
# MEETING_STATS_REPORT_SEND_AT_UTC=12:00

MEETING_WECHAT_MINIPROGRAM_APP_ID=replace_with_real_wechat_app_id
MEETING_WECHAT_MINIPROGRAM_APP_SECRET=replace_with_real_wechat_app_secret
MEETING_WECHAT_MINIPROGRAM_API_BASE_URL=https://api.weixin.qq.com
MEETING_STUN_URLS=stun:stun.l.google.com:19302
MEETING_TURN_URLS=turn:turn.meeting.07c2.com.cn:3478?transport=udp,turn:turn.meeting.07c2.com.cn:3478?transport=tcp,turns:turn.meeting.07c2.com.cn:5349?transport=tcp
MEETING_TURN_SHARED_SECRET=replace_with_real_turn_shared_secret
MEETING_TURN_TTL_SECONDS=43200

# Optional AI assistant transcription and persistent minutes.
# Keep this disabled until ASR / LLM credentials and cost limits are ready.
MEETING_TRANSCRIPTION_ENABLED=false
MEETING_ASR_PROVIDER=tencent
MEETING_ASR_API_BASE_URL=https://asr.tencentcloudapi.com
MEETING_TENCENT_ASR_SECRET_ID=replace_with_real_tencent_secret_id
MEETING_TENCENT_ASR_SECRET_KEY=replace_with_real_tencent_secret_key
MEETING_TENCENT_ASR_REGION=ap-shanghai
MEETING_TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
MEETING_TENCENT_ASR_VOICE_FORMAT=wav
MEETING_ASR_LANGUAGE_DEFAULT=zh-CN
MEETING_ASR_CHUNK_MAX_BYTES=1048576
MEETING_TRANSCRIPTION_MEETING_LIMIT_SECONDS=3600
MEETING_TRANSCRIPTION_DAILY_LIMIT_SECONDS=7200
MEETING_TRANSCRIPTION_CONCURRENT_PARTICIPANTS=3
MEETING_LLM_PROVIDER=deepseek
MEETING_LLM_API_BASE_URL=https://api.deepseek.com
MEETING_LLM_API_KEY=replace_with_real_deepseek_api_key
MEETING_LLM_MODEL=deepseek-v4-flash
MEETING_MINUTES_JOB_TIMEOUT_SECONDS=600

# Optional SMTP provider. Use this mode for Aliyun DirectMail or other SMTP services.
# Aliyun DirectMail example:
# MEETING_MAILER_MODE=smtp
# MEETING_SMTP_HOST=smtpdm.aliyun.com
# MEETING_SMTP_PORT=465
# MEETING_SMTP_USERNAME=no-reply@mail.07c2.com.cn
# MEETING_SMTP_PASSWORD=replace_with_real_smtp_password
# MEETING_SMTP_FROM_ADDRESS=no-reply@mail.07c2.com.cn
# MEETING_SMTP_FROM_NAME=meeting
# MEETING_SMTP_REQUIRE_TLS=true
# MEETING_SMTP_TLS_MODE=implicit
#
# SendCloud SMTP fallback example:
# MEETING_SMTP_HOST=smtp.sendcloud.net
# MEETING_SMTP_PORT=587
# MEETING_SMTP_USERNAME=replace_with_real_username
# MEETING_SMTP_PASSWORD=replace_with_real_password
# MEETING_SMTP_FROM_ADDRESS=no-reply@mail.07c2.com.cn
# MEETING_SMTP_FROM_NAME=meeting
# MEETING_SMTP_REQUIRE_TLS=true
# MEETING_SMTP_TLS_MODE=starttls
